# Plantilla de variables de entorno. Copiar a prode/prode/.env y completar.
# El .env real NO se versiona (esta en .gitignore). Nunca poner valores reales aqui.

DB_URL=jdbc:postgresql://localhost:5432/prode_db
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
JWT_EXPIRATION_MS=86400000

APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@prode.local
APP_ADMIN_PASSWORD=CAMBIAR

# HTTPS (opcional). Por defecto HTTP local (SSL_ENABLED=false).
# Para HTTPS local: generar el keystore en ./certs (ver DOCUMENTACION.md) y completar.
SSL_ENABLED=false
SSL_KEYSTORE_PATH=file:./certs/prode-keystore.p12
SSL_KEYSTORE_PASSWORD=CAMBIAR
SSL_KEY_ALIAS=prode
