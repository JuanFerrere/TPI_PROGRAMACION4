            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Boca Juniors\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/teams", "host": ["{{baseUrl}}"], "path": ["api", "teams"] }
          }
        },
        {
          "name": "Listar / buscar equipos",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/teams?name=", "host": ["{{baseUrl}}"], "path": ["api", "teams"], "query": [ { "key": "name", "value": "", "description": "filtro opcional por nombre" } ] }
          }
        },
        {
          "name": "Obtener equipo",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
